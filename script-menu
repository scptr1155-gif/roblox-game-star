local C = {
  bg = Color3.fromRGB(9, 10, 14), bgTop = Color3.fromRGB(19, 21, 31), panel = Color3.fromRGB(13, 15, 20),
  card = Color3.fromRGB(22, 25, 33), cardHi = Color3.fromRGB(31, 35, 46), line = Color3.fromRGB(38, 42, 53),
  text = Color3.fromRGB(240, 242, 247), muted = Color3.fromRGB(144, 149, 165), faint = Color3.fromRGB(98, 103, 120),
  ok = Color3.fromRGB(34, 197, 94), danger = Color3.fromRGB(239, 68, 68), white = Color3.fromRGB(255, 255, 255),
}
local FNT = { reg = Enum.Font.Gotham, med = Enum.Font.GothamMedium, bold = Enum.Font.GothamBold }
local AL = Enum.TextXAlignment.Left
M.C, M.FNT = C, FNT

local function new(class, props, parent)
  local ok, o = pcall(function() return Instance.new(class) end)
  if not ok or not o then return nil end
  if props then for k, v in pairs(props) do safe(function() o[k] = v end) end end
  if parent then safe(function() o.Parent = parent end) end
  return o
end
local function round(o, r) if o then new("UICorner", { CornerRadius = UDim.new(0, r or 12) }, o) end end
local function stroke(o, col) if o then new("UIStroke", { ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Color = col, Thickness = 1 }, o) end end
M.new, M.round, M.stroke = new, round, stroke

-- Script Hub logosu. LOGO_ID bir DECAL: önce rbxassetid denenir, 4 sn içinde yüklenmezse thumbnail'e geçer.
function M.logo(parent, x, y, w, h, z)
  local img = new("ImageLabel", {
    Size = UDim2.fromOffset(w or 52, h or 52), Position = UDim2.fromOffset(x or 0, y or 0),
    BackgroundTransparency = 1, BorderSizePixel = 0, ScaleType = Enum.ScaleType.Fit,
    Image = "rbxassetid://" .. tostring(M.LOGO_ID), ZIndex = z or 5,
  }, parent)
  if img then
    spawn(function()
      sleep(4)
      local ok, loaded = pcall(function() return img.IsLoaded end)
      if ok and loaded == false then
        safe(function() img.Image = "rbxthumb://type=Asset&id=" .. tostring(M.LOGO_ID) .. "&w=420&h=420" end)
      end
    end)
  end
  return img
end

-- Ortak pencere. o: name, title, sub, back, backText, w, h, order, noMin, logo
-- Dönüş: u (gui, window, bg, toast, loading, pill, label, input, scroll, backBtn, xBtn, close, alive ...)
function M.ui(ctx, o)
  ctx, o = ctx or {}, o or {}
  local u = { C = C, FNT = FNT, new = new, round = round, stroke = stroke }
  local accent = ctx.accent or Color3.fromRGB(88, 101, 242)
  local accentHi = accent:Lerp(Color3.new(1, 1, 1), 0.18)
  local animOn = ctx.anim ~= false
  u.accent, u.accentHi = accent, accentHi
  local name = o.name or "Panel"
  S.GUIS = S.GUIS or {}
  safe(function() if S.GUIS[name] then S.GUIS[name]:Destroy() end end)
  safe(M.startWatchdog)

  local gui = new("ScreenGui", {
    Name = "LoadSystem" .. name, ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = o.order or 800,
    ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
  })
  if not gui then return nil end
  local attached = false
  if CoreGui then attached = pcall(function() gui.Parent = CoreGui end) and gui.Parent == CoreGui end
  if not attached then pcall(function() gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui") end) end
  S.GUIS[name] = gui
  u.gui = gui

  local alive = true
  u.locked = false
  function u.alive() return alive end

  local function tw(obj, goal, t)
    if not obj then return end
    if animOn and TweenService then
      local ok = pcall(function()
        TweenService:Create(obj, TweenInfo.new(t or 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal):Play()
      end)
      if ok then return end
    end
    for k, v in pairs(goal) do safe(function() obj[k] = v end) end
  end
  u.tw = tw

  function u.label(parent, text, x, y, w, h, size, font, color, extra)
    local p = {
      Size = UDim2.fromOffset(w, h), Position = UDim2.fromOffset(x, y), BackgroundTransparency = 1,
      Text = text, TextColor3 = color or C.text, TextSize = size or 12, Font = font or FNT.reg,
      TextXAlignment = AL, ZIndex = 4,
    }
    if extra then for k, v in pairs(extra) do p[k] = v end end
    return new("TextLabel", p, parent)
  end

  local bg = new("Frame", {
    Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.bg, BackgroundTransparency = (ctx.bg == false) and 0 or 1,
    BorderSizePixel = 0, ZIndex = 0,
  }, gui)
  new("UIGradient", { Color = ColorSequence.new(C.bgTop, C.bg), Rotation = 150 }, bg)
  u.bg = bg

  local W, H, PAD = o.w or 880, o.h or 520, 28
  u.W, u.H, u.PAD, u.IW = W, H, PAD, W - PAD * 2
  local window = new("Frame", {
    Size = UDim2.fromOffset(W, H), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
    BackgroundColor3 = C.panel, BorderSizePixel = 0, ZIndex = 2,
  }, bg)
  round(window, 18)
  stroke(window, C.line)
  u.window = window
  local uiScale = new("UIScale", { Scale = 1 }, window)
  local function fit()
    local vp = Vector2.new(1280, 720)
    safe(function() local cam = Workspace.CurrentCamera if cam then vp = cam.ViewportSize end end)
    local s = math.min((vp.X - 24) / W, (vp.Y - 24) / H, 1)
    if s <= 0 then s = 1 end
    safe(function() uiScale.Scale = math.max(0.35, s) end)
  end
  fit()
  local camConn
  safe(function() camConn = Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit) end)

  function u.close()
    alive = false
    safe(function() if camConn then camConn:Disconnect() end end)
    safe(function() gui:Destroy() end)
    if S.GUIS[name] == gui then S.GUIS[name] = nil end
  end

  -- Bildirim (2 satır)
  local toastF = new("Frame", {
    Size = UDim2.fromOffset(math.min(620, W - 40), 56), AnchorPoint = Vector2.new(0.5, 1),
    Position = UDim2.new(0.5, 0, 1, 90), BackgroundColor3 = C.cardHi, BorderSizePixel = 0, Visible = false, ZIndex = 60,
  }, window)
  round(toastF, 16)
  stroke(toastF, C.line)
  local toastDot = new("Frame", {
    Size = UDim2.fromOffset(8, 8), Position = UDim2.fromOffset(18, 24), BackgroundColor3 = C.muted, BorderSizePixel = 0, ZIndex = 61,
  }, toastF)
  round(toastDot, 4)
  local toastT = u.label(toastF, "", 36, 4, math.min(620, W - 40) - 52, 48, 12, FNT.med, C.text, { ZIndex = 61, TextWrapped = true })
  local toastTok = 0
  function u.toast(text, color, dur)
    toastTok = toastTok + 1
    local my = toastTok
    safe(function()
      toastT.Text = tostring(text or "")
      toastDot.BackgroundColor3 = color or C.muted
      toastF.Visible = true
    end)
    tw(toastF, { Position = UDim2.new(0.5, 0, 1, -18) }, 0.3)
    delay(dur or 5, function()
      if my ~= toastTok or not alive then return end
      tw(toastF, { Position = UDim2.new(0.5, 0, 1, 90) }, 0.3)
    end)
  end

  -- Tam ekran yükleniyor
  local ov = new("Frame", {
    Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(0, 0, 0), BorderSizePixel = 0,
    Visible = false, Active = true, ZIndex = 200,
  }, gui)
  local ovTitle = new("TextLabel", {
    Size = UDim2.fromOffset(900, 56), Position = UDim2.fromScale(0.5, 0.45), AnchorPoint = Vector2.new(0.5, 0.5),
    BackgroundTransparency = 1, Text = "", TextColor3 = C.white, TextSize = 32, Font = FNT.bold, ZIndex = 201,
  }, ov)
  local ovSub = new("TextLabel", {
    Size = UDim2.fromOffset(900, 24), Position = UDim2.fromScale(0.5, 0.52), AnchorPoint = Vector2.new(0.5, 0.5),
    BackgroundTransparency = 1, Text = "", TextColor3 = Color3.fromRGB(150, 152, 158), TextSize = 13, Font = FNT.med, ZIndex = 201,
  }, ov)
  local barBg = new("Frame", {
    Size = UDim2.fromOffset(280, 4), Position = UDim2.fromScale(0.5, 0.6), AnchorPoint = Vector2.new(0.5, 0.5),
    BackgroundColor3 = Color3.fromRGB(40, 42, 48), BorderSizePixel = 0, ZIndex = 201,
  }, ov)
  local bar = new("Frame", { Size = UDim2.fromOffset(0, 4), BackgroundColor3 = accent, BorderSizePixel = 0, ZIndex = 202 }, barBg)
  local barTween
  -- determinate=true: çubuk loadingInfo(sub, 0..1) ile ilerler (kendi kendine dönmez)
  function u.loading(show, title, sub, determinate)
    safe(function()
      if barTween then barTween:Cancel() barTween = nil end
      if show then
        ovTitle.Text, ovSub.Text = tostring(title or ""), tostring(sub or "")
        bar.Size = UDim2.fromOffset(0, 4)
        ov.Visible = true
        if not determinate and TweenService then
          barTween = TweenService:Create(bar, TweenInfo.new(1.1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
            { Size = UDim2.fromOffset(280, 4) })
          barTween:Play()
        end
      else
        ov.Visible = false
      end
    end)
  end
  function u.loadingInfo(sub, p)
    safe(function()
      if sub then ovSub.Text = tostring(sub) end
      if p then bar.Size = UDim2.fromOffset(math.floor(280 * math.max(0, math.min(1, p))), 4) end
    end)
  end

  -- Düğme. fill: true = vurgu rengi, Color3 = o renk, yoksa kart rengi
  function u.pill(text, x, y, w, h, fill, parent)
    local base, hi
    if fill == true then base, hi = accent, accentHi
    elseif typeof(fill) == "Color3" then base, hi = fill, fill:Lerp(Color3.new(1, 1, 1), 0.15)
    else base, hi = C.card, C.cardHi end
    local b = new("TextButton", {
      Size = UDim2.fromOffset(w, h), Position = UDim2.fromOffset(x, y), BackgroundColor3 = base, BorderSizePixel = 0,
      Text = text, TextColor3 = fill and C.white or C.text, TextSize = 12, Font = FNT.bold, AutoButtonColor = false, ZIndex = 4,
    }, parent or window)
    round(b, 10)
    if not fill then stroke(b, C.line) end
    b.MouseEnter:Connect(function() tw(b, { BackgroundColor3 = hi }, 0.12) end)
    b.MouseLeave:Connect(function() tw(b, { BackgroundColor3 = base }, 0.12) end)
    return b
  end

  function u.input(y, h, placeholder, multi, parent)
    local f = new("Frame", {
      Size = UDim2.fromOffset(u.IW, h), Position = UDim2.fromOffset(PAD, y), BackgroundColor3 = C.card, BorderSizePixel = 0,
      ClipsDescendants = true, ZIndex = 3,
    }, parent or window)
    round(f, 10)
    stroke(f, C.line)
    return new("TextBox", {
      Size = UDim2.new(1, -24, 1, -(multi and 16 or 0)), Position = UDim2.fromOffset(12, multi and 8 or 0),
      BackgroundTransparency = 1, Text = "", PlaceholderText = placeholder, PlaceholderColor3 = C.faint,
      TextColor3 = C.text, TextSize = 13, Font = FNT.reg, ClearTextOnFocus = false, MultiLine = multi and true or false,
      TextWrapped = multi and true or false, TextXAlignment = AL,
      TextYAlignment = multi and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center, ZIndex = 4,
    }, f)
  end

  function u.scroll(x, y, w, h, parent)
    local sf = new("ScrollingFrame", {
      Size = UDim2.fromOffset(w, h), Position = UDim2.fromOffset(x, y), BackgroundTransparency = 1, BorderSizePixel = 0,
      ScrollBarThickness = 3, CanvasSize = UDim2.fromOffset(0, 0),
      AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 3,
    }, parent or window)
    new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, sf)
    return sf
  end

  -- Başlık satırı
  local tx = PAD
  if o.back then
    u.backBtn = u.pill(o.backText or "← GERİ", PAD, 24, 110, 38, false)
    tx = PAD + 126
  end
  if o.logo then
    M.logo(window, tx, 12, 52, 52, 5)
    tx = tx + 64
  end
  if o.sub then
    u.title = u.label(window, o.title or "", tx, 20, 400, 28, 22, FNT.bold, C.text)
    u.label(window, o.sub, tx, 48, 440, 16, 12, FNT.reg, C.muted)
  else
    u.title = u.label(window, o.title or "", tx, 22, 400, 42, 24, FNT.bold, C.text)
  end
  u.xBtn = u.pill("X", W - PAD - 34, 24, 34, 38, false)

  -- X: küçül -> kare -> "CR" logosu -> kenara git. Logoya basınca geri açılır.
  local minimized = false
  local hiddenKids = {}
  local logoBtn = new("TextButton", {
    Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "CR", TextColor3 = C.white, TextSize = 22,
    Font = FNT.bold, AutoButtonColor = false, Visible = false, ZIndex = 100,
  }, window)
  local function setMin(on)
    if on == minimized or u.locked then return end
    minimized = on
    if on then
      safe(function() window.ClipsDescendants = true end)
      tw(window, { Size = UDim2.fromOffset(64, 64), BackgroundColor3 = accent }, 0.3)
      tw(bg, { BackgroundTransparency = 1 }, 0.3)
      delay(0.34, function()
        if not minimized or not alive then return end
        for _, c in ipairs(window:GetChildren()) do
          if c ~= logoBtn and c:IsA("GuiObject") then hiddenKids[c] = c.Visible c.Visible = false end
        end
        logoBtn.Visible = true
        tw(window, { Position = UDim2.new(1, -52, 0.5, 0) }, 0.5)
      end)
    else
      logoBtn.Visible = false
      tw(window, { Position = UDim2.fromScale(0.5, 0.5) }, 0.3)
      delay(0.32, function()
        if minimized or not alive then return end
        tw(window, { Size = UDim2.fromOffset(W, H), BackgroundColor3 = C.panel }, 0.3)
        tw(bg, { BackgroundTransparency = (ctx.bg == false) and 0 or 1 }, 0.3)
        delay(0.3, function()
          if minimized or not alive then return end
          for c, v in pairs(hiddenKids) do safe(function() c.Visible = v end) end
          hiddenKids = {}
          safe(function() window.ClipsDescendants = false end)
        end)
      end)
    end
  end
  if not o.noMin then
    u.xBtn.MouseButton1Click:Connect(function() setMin(true) end)
    logoBtn.MouseButton1Click:Connect(function() setMin(false) end)
  end

  return u
end

