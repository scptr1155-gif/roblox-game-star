      s.good = s.good + M.num(e.good)
      s.bad = s.bad + M.num(e.bad)
      if M.num(e.created) > s.last then s.last = M.num(e.created) end
      s.mine[#s.mine + 1] = e
    end
  end
  for _, s in ipairs(list) do
    table.sort(s.mine, function(a, b) return M.num(a.id) > M.num(b.id) end)
  end
  return map, list
