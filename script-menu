function M.dailyLeft(nick, idx)
  local key = M.nickKey(nick)
  local now = os.time()
  local day = math.floor(now / 86400)
  for _, e in ipairs((idx and idx.scripts) or {}) do
    if M.ownerNickOf(e) == key and math.floor(M.num(e.created) / 86400) == day then
      return (day + 1) * 86400 - now
