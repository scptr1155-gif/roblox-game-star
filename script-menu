-- Metnin verilen genişlikte kaç piksel yükseklik ve genişlik kaplayacağı (yükseklik, genişlik)
function M.textHeight(text, size, font, width)
  text = tostring(text or "")
  local ok, v = pcall(function()
    return TextService:GetTextSize(text, size, font, Vector2.new(width, 10000))
  end)
  if ok and v then return v.Y, v.X end
  local perLine = math.max(1, math.floor(width / (size * 0.55)))
  local lines = math.max(1, math.ceil(#text / perLine))
  return lines * (size + 2), math.min(width, #text * size * 0.55)
end

local function listSpec(file, msg, field)
  return {
    file = file, msg = msg,
    empty = function() local t = {} t[field] = {} return t end,
    check = function(p)
      if type(p) ~= "table" then return nil end
      if p[field] == nil then p[field] = {} end
      if type(p[field]) ~= "table" then return nil end
      return p
    end,
  }
end

