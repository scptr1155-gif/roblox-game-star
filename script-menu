local function callTimeout(fn, timeout)
  local box = { done = false }
  spawn(function()
    local ok, a = pcall(fn)
    box.ok, box.a = ok, a
    box.done = true
  end)
  local waited = 0
  while not box.done and waited < timeout do
    sleep(0.05)
    waited = waited + 0.05
  end
  if not box.done then return nil, "zaman asimi" end
  if not box.ok then return nil, tostring(box.a) end
  return box.a
end
M.callTimeout = callTimeout

-- Dönüş: durumKodu, govde | nil, hata ("no_req" = hiç yöntem yok)
local function req(url, method, body, headers)
  method = method or "GET"
  local providers = {}
  if type(request) == "function" then
    providers[#providers + 1] = function() return request({ Url = url, Method = method, Headers = headers, Body = body }) end
  end
  if type(http_request) == "function" then
    providers[#providers + 1] = function() return http_request({ Url = url, Method = method, Headers = headers, Body = body }) end
  end
  if type(syn) == "table" and type(syn.request) == "function" then
    providers[#providers + 1] = function() return syn.request({ Url = url, Method = method, Headers = headers, Body = body }) end
  end
  if HttpService then
    providers[#providers + 1] = function() return HttpService:RequestAsync({ Url = url, Method = method, Headers = headers, Body = body }) end
  end
  if #providers == 0 then return nil, "no_req" end
  local lastErr = "bilinmeyen hata"
  for _, p in ipairs(providers) do
    local res, err = callTimeout(p, 25)
    if type(res) == "table" then
      local code = tonumber(res.StatusCode or res.Status or res.status_code or res.code) or 0
      local txt = res.Body or res.body or res.Content or ""
      if code > 0 then return code, tostring(txt) end
      lastErr = "gecersiz yanit"
    else
      lastErr = tostring(err or "yanit yok")
    end
  end
  return nil, lastErr
end
M.req = req

