function M.httpGet(url)
  -- devre kesici: üst üste çok hata olduysa kısa süre hiç istek atma
  if os.clock() < GUARD.cool then return nil end
  -- en fazla 3 eşzamanlı istek, istekler arası en az 0.12 sn
  local waited = 0
  while GUARD.active >= 3 and waited < 40 do sleep(0.1) waited = waited + 1 end
  local gap = 0.12 - (os.clock() - GUARD.last)
  if gap > 0 then sleep(gap) end
  GUARD.last = os.clock()
  GUARD.active = GUARD.active + 1
  local sep = url:find("?", 1, true) and "&" or "?"
  local ok, r = pcall(function() return game:HttpGet(url .. sep .. "t=" .. tostring(os.time())) end)
  GUARD.active = math.max(0, GUARD.active - 1)
  if ok and type(r) == "string" then
    GUARD.fails = 0
    if #r > 0 and r:sub(1, 14) ~= "404: Not Found" then return r end
    return nil
  end
  -- 404 (dosya yok) ağ hatası sayılmaz; diğer hatalar sayılır
  if not tostring(r):find("404", 1, true) then
    GUARD.fails = GUARD.fails + 1
    if GUARD.fails >= 6 then
      GUARD.cool = os.clock() + 15
      GUARD.fails = 0
    end
  end
  return nil
end

-- Scripti ayrı iş parçacığında, hata yakalayarak çalıştırır. Dönüş: true | false, hata
function M.runGuarded(code, label)
  if type(loadstring) ~= "function" then return false, "loadstring yok" end
  local fn, err = loadstring(tostring(code or ""))
  if not fn then return false, tostring(err) end
  local box = { done = false }
  local function body()
    local ok, e = pcall(fn)
    box.ok, box.err, box.done = ok, e, true
  end
  local th
  if type(task) == "table" and type(task.spawn) == "function" then th = task.spawn(body) else spawn(body) end
  local t0 = os.clock()
  while not box.done and os.clock() - t0 < 1.5 do sleep(0.1) end
  if box.done and not box.ok then return false, tostring(box.err) end
  if not box.done then
    S.THREADS[#S.THREADS + 1] = { th = th, label = tostring(label or "?"), t = os.time() }
    while #S.THREADS > 20 do table.remove(S.THREADS, 1) end
  end
  return true
end

-- runGuarded ile başlayıp hâlâ süren scriptleri durdurur (gerekirse menüye bağlanabilir)
function M.stopGuarded()
  local n = 0
  for _, t in ipairs(S.THREADS) do
    if t.th and type(task) == "table" and type(task.cancel) == "function" then
      if pcall(task.cancel, t.th) then n = n + 1 end
    end
  end
  S.THREADS = {}
  return n
end

-- Bekçi: kapanmış ekran kayıtlarını temizler, bellek şişerse çöp toplar, ekran yoksa kendini durdurur
function M.startWatchdog()
  if S.WD then return end
  S.WD = true
  spawn(function()
    local idle = 0
    while true do
      sleep(10)
      local any = false
      for k, g in pairs(S.GUIS or {}) do
        local okp, par = pcall(function() return g.Parent end)
        if not okp or par == nil then S.GUIS[k] = nil else any = true end
      end
      local okc, kb = pcall(collectgarbage, "count")
      if okc and type(kb) == "number" and kb > 250000 then pcall(collectgarbage, "collect") end
      if any then idle = 0 else idle = idle + 1 end
      if idle >= 6 then break end
    end
    S.WD = false
  end)
end

function M.readIndex()
  local src = M.httpGet(STORE .. INDEX_FILE)
  if not src then return { next = 1, scripts = {} } end
  local d = jsonDecode(src)
  if type(d) == "table" then
    if type(d.scripts) ~= "table" then d.scripts = {} end
    return d
  end
  return { next = 1, scripts = {} }
end

-- Profiller: { profiles = { [takmaAdKucuk] = { nick, name, uid, joined, rbxCreated, bio, status, avatar, edited } } }
function M.readProfiles()
  local src = M.httpGet(STORE .. PROFILES_FILE)
  local d = src and jsonDecode(src)
  if type(d) == "table" then
    if type(d.profiles) ~= "table" then d.profiles = {} end
    return d
  end
  return { profiles = {} }
end

-- Kayıtlı oyuncular: loadsystem/player dosyasından SADECE takma ad (playert) ve Roblox adı (player) alınır.
-- Şifre alanı okunmaz/saklanmaz. Dosya okunamazsa nil döner.
function M.readPlayerList()
  local src = M.httpGet(BASE .. "player")
  if not src then return nil end
  src = src:gsub("\239\187\191", "")
  local list = {}
  for line in src:gmatch("[^\r\n]+") do
    local nick, name
    for field in line:gmatch("[^/]+") do
      local k, v = field:match("^%s*([^:]+):(.*)$")
      if k then
        k = (k:lower():gsub("%s+", ""))
        if k == "playert" then nick = M.trim(v)
        elseif k == "player" then name = M.trim(v) end
      end
    end
    if nick and nick ~= "" then list[#list + 1] = { nick = nick, name = name or "" } end
  end
  return list
end

function M.fetchLoad(url)
  local src = M.httpGet(url)
  if not src then return false, "indirilemedi" end
  if #((src:gsub("%s+", ""))) == 0 then return false, "bos dosya" end
  if type(loadstring) ~= "function" then return false, "loadstring yok" end
  local fn, cerr = loadstring(src)
  if not fn then
    local ln = tonumber(tostring(cerr):match(":(%d+):"))
    local n, txt = 0, ""
    for line in (src .. "\n"):gmatch("(.-)\n") do
      n = n + 1
      if n == ln then txt = line break end
    end
    print("[hubcore] derleme hatasi " .. tostring(cerr) .. " | satir: " .. txt:sub(1, 120))
    return false, "L" .. tostring(ln) .. ": " .. txt:sub(1, 50)
  end
  local okR, mod = pcall(fn)
  if not okR then return false, tostring(mod) end
  return true, mod
end

