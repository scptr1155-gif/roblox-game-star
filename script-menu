  local st = { count = 0, uses = 0, good = 0, bad = 0, mine = {}, best = nil, rank = nil, authors = #list, last = 0 }
  if s then
    st.count, st.uses, st.good, st.bad, st.mine, st.last = s.count, s.uses, s.good, s.bad, s.mine, s.last
    for _, e in ipairs(s.mine) do
      if not st.best or (M.num(e.good) - M.num(e.bad)) > (M.num(st.best.good) - M.num(st.best.bad)) then st.best = e end
    end
    local better = 0
    for _, o in ipairs(list) do
      if o.uses > s.uses then better = better + 1 end
    end
    st.rank = better + 1
  end
  return st
end

