local function sleep(s)
  if type(task) == "table" and type(task.wait) == "function" then task.wait(s or 0)
  elseif type(wait) == "function" then wait(s or 0) end
end
local function spawn(fn, ...)
  local args = table.pack(...)
  local function run()
    local ok, err = pcall(fn, table.unpack(args, 1, args.n))
    if not ok then
      S.LASTERR = tostring(err)
      if S.DEBUG then pcall(warn, "[hubcore] " .. tostring(err)) end
    end
  end
  if type(task) == "table" and type(task.spawn) == "function" then return task.spawn(run) end
  local co = coroutine.create(run)
  coroutine.resume(co)
  return co
end
local function delay(t, fn)
  if type(task) == "table" and type(task.delay) == "function" then return task.delay(t, fn) end
  spawn(function() sleep(t) fn() end)
end
local function safe(fn, ...)
  local ok, a = pcall(fn, ...)
  return ok, a
end
M.sleep, M.spawn, M.delay, M.safe = sleep, spawn, delay, safe

