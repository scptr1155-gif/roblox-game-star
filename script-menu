  return {
    file = FRIENDS_FILE, msg = "hub: friends",
    empty = function() return { links = {}, names = {} } end,
    check = function(p)
      if type(p) ~= "table" then return nil end
      if type(p.links) ~= "table" then p.links = {} end
      if type(p.names) ~= "table" then p.names = {} end
      return p
    end,
  }
end

function M.readFriends()
  local d = M.readJson(FRIENDS_FILE)
  if type(d) ~= "table" then d = {} end
  if type(d.links) ~= "table" then d.links = {} end
  if type(d.names) ~= "table" then d.names = {} end
  return d
end

-- "none" | "friend" | "sent" (ben gönderdim) | "received" (bana gönderdi)
function M.friendState(db, me, other)
  local a, b = M.nickKey(me), M.nickKey(other)
  local l = db and db.links and db.links[a]
  local e = type(l) == "table" and l[b] or nil
  if type(e) ~= "table" then return "none" end
  if e.s == "f" then return "friend" end
  if e.from == a then return "sent" end
  return "received"
end

-- { friends = {{key,nick,t}}, incoming = {...}, outgoing = {...} } (takma ada göre sıralı)
function M.friendList(db, me)
  local a = M.nickKey(me)
  local out = { friends = {}, incoming = {}, outgoing = {} }
  local l = db and db.links and db.links[a]
  if type(l) == "table" then
    for bk, e in pairs(l) do
      if type(e) == "table" then
        local item = { key = bk, nick = tostring((db.names and db.names[bk]) or bk), t = M.num(e.t) }
        if e.s == "f" then out.friends[#out.friends + 1] = item
        elseif e.from == a then out.outgoing[#out.outgoing + 1] = item
        else out.incoming[#out.incoming + 1] = item end
      end
    end
  end
  local function byNick(x, y) return string.lower(x.nick) < string.lower(y.nick) end
  table.sort(out.friends, byNick)
  table.sort(out.incoming, byNick)
  table.sort(out.outgoing, byNick)
  return out
end

local function setLink(db, a, b, v)
  if type(db.links[a]) ~= "table" then db.links[a] = {} end
  if type(db.links[b]) ~= "table" then db.links[b] = {} end
  db.links[a][b] = v
  db.links[b][a] = { s = v.s, from = v.from, t = v.t }
end

local function dropLink(db, a, b)
  if type(db.links[a]) == "table" then db.links[a][b] = nil end
  if type(db.links[b]) == "table" then db.links[b][a] = nil end
end

local function badPlayer(lang) return (lang == "en") and "Invalid player." or "Geçersiz oyuncu." end

-- { friends = n, outgoing = n } (bu anahtarın arkadaşları ve gönderdiği bekleyen istekler)
function M.friendCounts(db, key)
  local f, o = 0, 0
  local l = db and db.links and db.links[key]
  if type(l) == "table" then
    for _, e in pairs(l) do
      if type(e) == "table" then
        if e.s == "f" then f = f + 1 elseif e.from == key then o = o + 1 end
      end
    end
  end
  return { friends = f, outgoing = o }
end

function M.friendLimitMsg(lang, vip)
  local lim = M.limits(vip).friends
  if lang == "en" then
    if vip then return "Friend limit reached (" .. lim .. ")." end
    return "Friend limit reached (" .. lim .. "). VIP raises it to " .. M.VIP.FRIENDS.vip .. "."
  end
  if vip then return "Arkadaş sınırına ulaştın (" .. lim .. ")." end
  return "Arkadaş sınırına ulaştın (" .. lim .. "). VIP ile " .. M.VIP.FRIENDS.vip .. "'e çıkar."
end

-- Dönüş: true, "friend" | "sent"
function M.friendRequest(me, other, lang)
  local a, b = M.nickKey(me), M.nickKey(other)
  if a == "" or b == "" or a == b then return false, badPlayer(lang) end
  local vip = M.myVip()
  local lim = M.limits(vip).friends
  return mutateJson(friendsSpec(), function(db)
    db.names[a] = tostring(me)
    if db.names[b] == nil then db.names[b] = tostring(other) end
    local cur = type(db.links[a]) == "table" and db.links[a][b] or nil
    local cnt = M.friendCounts(db, a)
    if type(cur) == "table" then
      if cur.s == "f" then return true, "friend" end
      if cur.from == b then
        if cnt.friends >= lim then return false, M.friendLimitMsg(lang, vip) end
        setLink(db, a, b, { s = "f", from = b, t = os.time() })
        return true, "friend"
      end
      return true, "sent"
    end
    if cnt.friends + cnt.outgoing >= lim then return false, M.friendLimitMsg(lang, vip) end
    setLink(db, a, b, { s = "p", from = a, t = os.time() })
    return true, "sent"
  end, lang)
end

-- Bana gelen isteği kabul et. Dönüş: true, "friend"
function M.friendAccept(me, other, lang)
  local a, b = M.nickKey(me), M.nickKey(other)
  if a == "" or b == "" or a == b then return false, badPlayer(lang) end
  local vip = M.myVip()
  return mutateJson(friendsSpec(), function(db)
    db.names[a] = tostring(me)
    local cur = type(db.links[a]) == "table" and db.links[a][b] or nil
    if type(cur) ~= "table" then return false, badPlayer(lang) end
    if cur.s == "f" then return true, "friend" end
    if cur.from ~= b then return false, denied(lang) end
    if M.friendCounts(db, a).friends >= M.limits(vip).friends then return false, M.friendLimitMsg(lang, vip) end
    setLink(db, a, b, { s = "f", from = b, t = os.time() })
    return true, "friend"
  end, lang)
end

-- Reddet / isteği iptal et / arkadaşlıktan çık (üçü de aynı işlem)
function M.friendRemove(me, other, lang)
  local a, b = M.nickKey(me), M.nickKey(other)
  if a == "" or b == "" or a == b then return false, badPlayer(lang) end
  return mutateJson(friendsSpec(), function(db)
    dropLink(db, a, b)
    return true, "none"
  end, lang)
end

-- ---------- CR CHAT ----------
M.GLOBAL_CHAT = "chat/global.json"

local function encKey(k)
  return (tostring(k):gsub("[^%w]", function(c) return string.format("_%02x", c:byte()) end))
end

-- İki takma ad arasındaki özel sohbet dosyası (sıralama fark etmez)
function M.chatFile(a, b)
  local x, y = M.nickKey(a), M.nickKey(b)
  if x > y then x, y = y, x end
  return "chat/dm_" .. encKey(x) .. "~" .. encKey(y) .. ".json"
end

local function chatSpec(file)
  return {
    file = file, msg = "hub: chat",
    empty = function() return { msgs = {}, next = 1 } end,
    check = function(p)
      if type(p) ~= "table" then return nil end
      if p.msgs == nil then p.msgs = {} end
      if type(p.msgs) ~= "table" then return nil end
      p.next = math.max(1, math.floor(M.num(p.next)))
      return p
    end,
  }
end

-- Mesajlar, eskiden yeniye sıralı ({i, f = gonderenAnahtar, n = gonderenAd, m = metin, t = zaman}).
-- Okunamazsa boş liste.
function M.readChat(file)
  local d = M.readJson(file)
  local out = {}
  if d and type(d.msgs) == "table" then
    for _, m in ipairs(d.msgs) do
      if type(m) == "table" then out[#out + 1] = m end
    end
  end
  table.sort(out, function(a, b) return M.num(a.i) < M.num(b.i) end)
  return out
end

-- Dönüş: true, mesaj | false, hata. keep: dosyada tutulacak son mesaj sayısı.
function M.sendChat(file, nick, text, lang, keep)
  keep = keep or 150
  return mutateJson(chatSpec(file), function(db)
    local i = math.max(1, math.floor(M.num(db.next)))
    for _, m in ipairs(db.msgs) do
      if M.num(m.i) >= i then i = math.floor(M.num(m.i)) + 1 end
    end
    local m = { i = i, f = M.nickKey(nick), n = tostring(nick), m = text, t = os.time() }
    db.msgs[#db.msgs + 1] = m
    db.next = i + 1
    while #db.msgs > keep do table.remove(db.msgs, 1) end
    return true, m
  end, lang)
end

